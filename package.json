{
  "name": "free-fire-server",
  "version": "1.0.0",
  "description": "A Free Fire server emulator",
  "keywords": [
    "free-fire",
    "free",
    "fire",
    "garena"
  ],
  "license": "ISC",
  "author": "lugami",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "live": "node src/servers/live.js",
    "login": "node src/servers/login.js",
    "main": "node src/servers/main.js",
    "tcp": "node src/servers/tcp.js",
    "chat": "node src/servers/chat.js",
    "settlement": "node src/servers/settlement.js",
    "matchmaker": "node src/servers/matchmaker.js",
    "admin": "node scripts/admin.js",
    "admin:dev": "npm --prefix admin-ui run dev",
    "admin:build": "npm --prefix admin-ui run build",
    "dev": "nodemon --watch src --watch config --exec node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate-data": "node src/db/migrate-data.js",
    "backfill-friends": "node scripts/backfill-friends.js",
    "repo-smoke": "node scripts/repo-smoke.js",
    "settle-smoke": "node scripts/settle-smoke.js",
    "leader-smoke": "node scripts/leader-smoke.js",
    "room-smoke": "node scripts/room-smoke.js",
    "roomsettings-smoke": "node scripts/roomsettings-smoke.js",
    "chat-smoke": "node scripts/chat-smoke.js",
    "chat-integration-smoke": "node scripts/chat-integration-smoke.js",
    "character-smoke": "node scripts/character-availability-smoke.js",
    "character-system-smoke": "node scripts/character-system-smoke.js",
    "match-skill-smoke": "node scripts/match-skill-handoff-smoke.js",
    "protocol-feature-smoke": "node scripts/protocol-feature-smoke.js",
    "luck-royale-smoke": "node scripts/luck-royale-smoke.js",
    "csadvanced-smoke": "node scripts/csadvanced-smoke.js",
    "protocol-smoke": "node scripts/local-protocol-smoke.js",
    "apk-auth-test": "node scripts/apk-local-auth-server.js",
    "lint": "eslint . --ext .js",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "http-errors": "^2.0.0",
    "ioredis": "^5.11.1",
    "morgan": "^1.12.1",
    "pg": "^8.22.0",
    "protobufjs": "^7.6.6",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.41.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  }
