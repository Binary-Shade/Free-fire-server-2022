{
  "name": "@auth/root",
  "private": true,
  "version": "0.1.0",
  "description": "Local or Discord-backed authentication services for the legacy client SDK.",
  "workspaces": [
    "shared",
    "connect-server",
    "login-server"
  ],
  "scripts": {
    "dev": "run-p dev:connect dev:login",
    "dev:connect": "nodemon --watch connect-server/src --watch shared/src connect-server/src/index.js",
    "dev:login": "nodemon --watch login-server/src --watch shared/src login-server/src/index.js",
    "start": "run-p start:connect start:login",
    "start:connect": "node connect-server/src/index.js",
    "start:login": "node login-server/src/index.js",
    "migrate:pg": "node scripts/migrate-mongo-to-pg.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "fast-copy": "3.1.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  }
}
